# TypeSafe (Jev) API key. Only needed when JEV_MODE=live.
TYPESAFE_API_KEY=
# mock: synthesize Jev answers locally (no network, no cost). live: call the real API.
JEV_MODE=mock
# Gateway
PORT=8787
# Interface to listen on. Keep 127.0.0.1 unless you want the dashboard reachable from other machines.
HOST=127.0.0.1
UPSTREAM_BASE_URL=https://api.anthropic.com
GATEWAY_DB=jev-gateway.db
# Routing (model: "auto")
# Spend cap for the gateway's own Jev calls, in USD (persisted via the request log).
JEV_BUDGET_USD=1
# Tier used when Jev is unsure, fails, times out or the budget is spent.
ROUTER_DEFAULT_TIER=opus-medium
# Jev confidence below this falls back to the default tier.
ROUTER_MIN_CONFIDENCE=0.5
# Per-call Jev timeout in ms.
JEV_TIMEOUT_MS=800
# Dashboard: the model every request is compared against ("what it would have cost").
BASELINE_TIER=opus-medium
# Cascade (cheap-first retry): answer with a cheap tier, ask Jev if it fully answers the request, else escalate to the routed tier.
# on|off. Per request, header x-gateway-cascade: on|off overrides this.
CASCADE_DEFAULT=off
# Tier tried first.
CASCADE_FIRST_TIER=haiku
# Jev pass probability needed to accept the cheap answer.
CASCADE_MIN_PASS=0.7
