# TypeSafe (Jev) API key. Only needed when JEV_MODE=live.
TYPESAFE_API_KEY=
# mock: synthesize Jev answers locally (no network, no cost). live: call the real API.
JEV_MODE=mock
# Gateway
PORT=8787
# Interface to listen on. Keep 127.0.0.1 unless you want the dashboard reachable from other machines.
HOST=127.0.0.1
UPSTREAM_BASE_URL=https://api.anthropic.com
GATEWAY_DB=jev-gateway.db
# Routing (model: "auto")
# Spend cap for the gateway's own Jev calls, in USD (persisted via the request log).
JEV_BUDGET_USD=1
# Tier used when Jev is unsure, fails, times out or the budget is spent.
ROUTER_DEFAULT_TIER=opus-medium
# Jev confidence below this falls back to the default tier.
ROUTER_MIN_CONFIDENCE=0.5
# Per-call Jev timeout in ms.
JEV_TIMEOUT_MS=800
# Dashboard: the model every request is compared against ("what it would have cost").
BASELINE_TIER=opus-medium
# Cascade (cheap-first retry): answer with a cheap tier, ask Jev if it fully answers the request, else escalate to the routed tier.
# on|off. Per request, header x-gateway-cascade: on|off overrides this.
CASCADE_DEFAULT=off
# Tier tried first.
CASCADE_FIRST_TIER=haiku
# Jev pass probability needed to accept the cheap answer.
CASCADE_MIN_PASS=0.7
# Tool trimming: ask Jev which tools a request needs and forward only those (saves input tokens).
# on|off. Per request, header x-gateway-trim-tools: on|off overrides this.
TRIM_TOOLS_DEFAULT=off
# Only trim requests with at least this many tools.
TRIM_TOOLS_MIN=15
# Keep tools Jev scores at or above this probability.
TRIM_TOOLS_MIN_PROB=0.2
# Always keep at least this many top-scored tools.
TRIM_TOOLS_KEEP_TOP=5
# Comma-separated tool names that are never removed.
TRIM_TOOLS_PINNED=
# Semantic answer cache: for simple single-turn, tool-free requests, reuse an earlier answer when Jev confirms it answers the new question too.
# on|off. Per request, header x-gateway-cache: on|off overrides this. The embedding model (Xenova/all-MiniLM-L6-v2) downloads once on first use.
CACHE_DEFAULT=off
# Hours a cached answer stays valid.
CACHE_TTL_HOURS=24
# Cosine similarity needed for an earlier question to be shown to Jev.
CACHE_MIN_SIMILARITY=0.8
# Jev probability needed to serve the cached answer.
CACHE_MIN_MATCH=0.85
# Most similar earlier questions sent to Jev per lookup.
CACHE_MAX_CANDIDATES=3
